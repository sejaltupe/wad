<!DOCTYPE html>
<html>
<head>
  <title>Simple Dashboard</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { margin: 0; }

    .sidebar {
      background: black;
      color: white;
      height: 100vh;
      padding: 10px;
      position: fixed;
      width: 16%;
    }

    .sidebar a {
      color: white;
      display: block;
      margin: 10px 0;
      text-decoration: none;
    }

    .sidebar a:hover {
      background: gray;
      padding-left: 10px;
    }

    .main {
      margin-left: 17%;
      padding: 20px;
    }

    .card {
      padding: 15px;
      color: white;
      margin: 5px;
    }

    .card:hover {
      transform: scale(1.05);
    }

    .section {
      margin-bottom: 60px;
    }
  </style>
</head>

<body>

<div class="container-fluid">
  <div class="row">

    <!-- Sidebar -->
    <div class="col-2 sidebar">
      <h3>Dashboard</h3>
      <a href="#home">Home</a>
      <a href="#students">Students</a>
      <a href="#exams">Exams</a>
      <a href="#results">Results</a>
    </div>

    <!-- Main Content -->
    <div class="col-10 main">

      <!-- HOME -->
      <div id="home" class="section">
        <h2>Admin Panel</h2>

        <div class="row">
          <div class="col-3">
            <div class="card bg-primary">
              <h5>Students</h5>
              <h3>1200</h3>
            </div>
          </div>

          <div class="col-3">
            <div class="card bg-success">
              <h5>Courses</h5>
              <h3>45</h3>
            </div>
          </div>

          <div class="col-3">
            <div class="card bg-warning">
              <h5>Exams</h5>
              <h3>30</h3>
            </div>
          </div>

          <div class="col-3">
            <div class="card bg-danger">
              <h5>Results</h5>
              <h3>12</h3>
            </div>
          </div>
        </div>
      </div>

      <!-- STUDENTS -->
      <div id="students" class="section">
        <h2>Students</h2>

        <table border="2" style="width: 50%; text-align: center;">
          <tr>
            <th>Sr.no</th>
            <th>Name</th>
            <th>Marks</th>
          </tr>
          <tr>
            <td>1</td>
            <td>Sejal</td>
            <td>64</td>
          </tr>
          <tr>
            <td>2</td>
            <td>abc</td>
            <td>57</td>
          </tr>
        </table>
      </div>

      <!-- EXAMS -->
      <div id="exams" class="section">
        <h2>Exams</h2>
        <p>Exam schedule will appear here.</p>
      </div>

      <!-- RESULTS -->
      <div id="results" class="section">
        <h2>Results</h2>
        <p>Results data will appear here.</p>
      </div>

    </div>

  </div>
</div>

</body>
</html>

