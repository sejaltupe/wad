<!DOCTYPE html>
<html>
<head>
  <title>User Registration</title>
</head>
<body style="background-color: blanchedalmond; text-align:center; color:blue;">

<h2>User Registration</h2>

<form id="regForm">
  Name: <input type="text" id="name" required><br><br>
  Email: <input type="email" id="email" required><br><br>
  Password: <input type="password" id="password" required><br><br>
  <button type="submit" style="background:black; color:orange;">Register</button>
</form>

<script>
document.getElementById("regForm").addEventListener("submit", function(e) {
  e.preventDefault();

  // get values
  let user = {
    name: document.getElementById("name").value,
    email: document.getElementById("email").value,
    password: document.getElementById("password").value
  };

  // get old users or empty array
  let users = JSON.parse(localStorage.getItem("users")) || [];

  // add new user
  users.push(user);

  // save back to localStorage
  localStorage.setItem("users", JSON.stringify(users));

  // redirect to list page
  window.location.href = "list.html";
});
</script>

</body>
</html>


